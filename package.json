{
  "name": "zuba",
  "version": "0.0.0",
  "main": "index.js",
  "author": "nelsonjr.dev@gmail.com",
  "license": "MIT",
  "private": true,
  "scripts": {
    "db:migrate": "yarn prisma migrate dev",
    "prepare": "husky",
    "fix": "run-s \"lint:fix {@}\" \"format:write {@}\" --",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern",
    "format:write": "prettier --write",
    "format": "yarn fix:format 'src/**/*.{js,ts,md,json}'",
    "lint": "yarn fix:lint 'src/**/*.(js|ts|md|json)'",
    "lint:all": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:all:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:all": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "prebuild": "rm -Rf ./dist",
    "build": "babel src --extensions \".js\" --ignore \"*.spec.js,*.test.js\" --out-dir dist --copy-files",
    "predev": "node DOCS/generate.js",
    "dev": "nodemon --exec babel-node -r dotenv-safe/config src/index.js",
    "test": "yarn jest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "./src/**/*.{js,md,json}": [
      "yarn fix"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "lint-staged": "^16.1.2",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "supertest": "^7.1.3",
    "swagger-jsdoc": "^6.2.8"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.1",
    "@prisma/client": "^6.12.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "bcrypt": "^6.0.0",
    "docker-compose": "^1.2.0",
    "dotenv": "^17.2.0",
    "dotenv-safe": "^9.1.0",
    "eslint": "^9.31.0",
    "jsonwebtoken": "^9.0.2",
    "koa": "^3.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-cors": "^0.0.16",
    "koa-router": "^13.1.1",
    "ramda": "^0.31.3",
    "swagger-injector": "^4.0.1"
  }
}
