{
  "name": "zuba",
  "version": "0.0.0",
  "main": "index.js",
  "author": "nelsonjr.dev@gmail.com",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "db:migrate": "yarn prisma migrate dev",
    "docs:generate": "node DOCS/generate.js",
    "prepare": "husky",
    "fix": "run-s \"lint:fix {@}\" \"format:write {@}\" --",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern",
    "format:write": "prettier --write",
    "format": "yarn format:write 'src/**/*.{js,ts,md,json}'",
    "lint": "yarn lint:fix 'src/**/*.{js,ts}'",
    "lint:all": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:all:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:all": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "prebuild": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true })\"",
    "build": "babel src --extensions \".js\" --ignore \"*.spec.js,*.test.js\" --out-dir dist --copy-files",
    "start": "node -r dotenv/config dist/index.js",
    "predev": "node DOCS/generate.js",
    "dev": "nodemon --exec babel-node -r dotenv-safe/config src/index.js",
    "test": "yarn jest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "./src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "./src/**/*.{md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^17.4.1",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prisma": "6",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.1",
    "@prisma/client": "6",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "dotenv-safe": "^8.2.0",
    "firebase-admin": "13.1.0",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "ramda": "^0.30.1",
    "swagger-injector": "^4.0.1",
    "zod": "^4.1.5"
  }
}
